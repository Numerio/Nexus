#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

# As of 2026-10-09 the kernel-flavour dependency is NOT declared in
# debian/control any more. The old ${kernel:headers} substitution baked a
# per-lane flavour (linux-headers-rt-amd64 / linux-headers-amd64 /
# linux-headers-arm64) into a package whose Architecture: all — the same suite
# .deb was reused across lanes with the build lane's own flavour, so every
# other lane failed apt resolution on it: the first arm64 failure after
# ae5bfe1 was exactly that (nexus-dkms Depends linux-headers-rt-amd64 in an
# arm64 chroot).
#
# The flavour's job is still done, at the place where it is actually known:
# the image phase installs linux-headers-<flavour of its own kernel> right
# before this package, and debian/preinst refuses to install nexus-dkms into
# a system that did not. The packages.sh flavour mapping (and any
# VOS_KERNEL_HEADERS_DEP override) is therefore no longer consulted here:
# whichever flavour the caller names, the check simply looks at what IS
# installed. A lane that still exports VOS_KERNEL_HEADERS_DEP does no harm;
# the variable is simply dead here and the old mapping recipe below is only
# kept to document the flavours the image phase expects to find.
#   amd64, trixie image (RT kernel)       -> linux-headers-rt-amd64
#   amd64, testing image (generic kernel) -> linux-headers-amd64
#   arm64  (generic linux-image-arm64)    -> linux-headers-arm64

# Deliberately no override_dh_gencontrol: the control file carries no
# substitution, so plain debhelper rules apply.

%:
	dh $@ --with dkms
