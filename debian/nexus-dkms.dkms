PACKAGE_NAME="nexus"
PACKAGE_VERSION="1"
BUILT_MODULE_NAME[0]="nexus"
BUILT_MODULE_LOCATION[0]="nexus"
DEST_MODULE_LOCATION[0]="/updates"
BUILT_MODULE_NAME[1]="area"
BUILT_MODULE_LOCATION[1]="nexus"
DEST_MODULE_LOCATION[1]="/updates"
BUILT_MODULE_NAME[2]="nexus_node_monitor"
BUILT_MODULE_LOCATION[2]="nexus"
DEST_MODULE_LOCATION[2]="/updates"
AUTOINSTALL="YES"
# kbuild only honours MO= from 7.x on: the modules land in nexus/ on 6.12 and
# nexus/build/ on 7.2, and BUILT_MODULE_LOCATION can only name one. Move them
# into the declared location; the copy is a no-op where they already are.
MAKE[0]="'make' -j$parallel_jobs -C nexus KERNEL_SRC=$kernel_source_dir && { cp -f nexus/build/*.ko nexus/ 2>/dev/null || true; }"
